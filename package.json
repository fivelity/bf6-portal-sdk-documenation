{
  "name": "bf6-portal-sdk-documentation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm run docs:api && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "docs:api": "pnpm run docs:api:mod-types && pnpm run docs:api:utils",
    "docs:api:mod-types": "typedoc --options typedoc/mod-types.json",
    "docs:api:utils": "typedoc --options typedoc/utils.json",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.3.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "bf6-portal-mod-types": "^4.3.0",
    "bf6-portal-utils": "^9.4.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=18.17.0"
  }
}
