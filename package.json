{
  "name": "bf6-portal-sdk-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm run docs:api && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "docs:api": "pnpm run docs:api:mod-types && pnpm run docs:api:utils",
    "docs:api:mod-types": "typedoc --options typedoc/mod-types.json",
    "docs:api:utils": "typedoc --options typedoc/utils.json",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.30.4",
    "astro": "^4.16.13",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "bf6-portal-mod-types": "^4.2.0",
    "bf6-portal-utils": "^9.4.0",
    "typedoc": "^0.26.11",
    "typedoc-plugin-markdown": "^4.2.10",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=18.17.0"
  }
}
