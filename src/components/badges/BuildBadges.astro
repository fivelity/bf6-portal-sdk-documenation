---
/**
 * BuildBadges — the header's build-provenance hovercard.
 *
 * Was three always-visible chips (Built with / Using / Elapsed), then a
 * single "Build info" <details> popover with a text trigger. Now it's a
 * single icon-only chip — same footprint as the header's GitHub icon —
 * that reveals the same three rows on hover, focus, or click (see
 * HoverCard.astro for exactly how). Each row stays its own
 * single-responsibility component (SRP): this file only decides which
 * rows appear and in what order.
 */
import HoverCard from '../HoverCard.astro';
import BuildToolBadge from './BuildToolBadge.astro';
import ModelBadge from './ModelBadge.astro';
import ElapsedBadge from './ElapsedBadge.astro';
---

<HoverCard label="Build provenance">
  <Fragment slot="icon">
    <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="M12 11v5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <circle cx="12" cy="7.75" r="1.1" fill="currentColor" />
  </Fragment>
  <div class="wd-hovercard__rows">
    <BuildToolBadge />
    <ModelBadge />
    <ElapsedBadge />
  </div>
</HoverCard>
