---
/**
 * Chip — the single reusable primitive every header badge is built from.
 * Single responsibility: render one icon + label + value in the flat
 * `.wd-chip` style. Nothing here knows about build info, SDK versions, or
 * git — those live in the small wrapper components below, which each pass
 * a resolved (already-formatted) label/value into this one.
 */
interface Props {
  icon?: 'tool' | 'model' | 'clock' | 'tag' | 'dot';
  label?: string;
  value: string;
  title?: string;
}
const { icon, label, value, title } = Astro.props;

const ICONS: Record<string, string> = {
  tool: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  model: '<rect x="3" y="8" width="18" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 8V6a4 4 0 0 1 8 0v2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="8.5" cy="13" r="1.1" fill="currentColor"/><circle cx="15.5" cy="13" r="1.1" fill="currentColor"/>',
  clock: '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  tag: '<path d="M20 12.5 12.5 20a1.5 1.5 0 0 1-2.12 0l-6.38-6.38a1.5 1.5 0 0 1 0-2.12L11.5 4H19a1 1 0 0 1 1 1v7.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="15.5" cy="8.5" r="1.2" fill="currentColor"/>',
  dot: '',
};
---

<span class="wd-chip" title={title}>
  {icon === 'dot' ? (
    <span class="wd-chip__dot" aria-hidden="true"></span>
  ) : icon ? (
    <svg class="wd-chip__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[icon]} />
  ) : null}
  {label && <span class="wd-chip__label">{label}</span>}
  <span class="wd-chip__value">{value}</span>
</span>
