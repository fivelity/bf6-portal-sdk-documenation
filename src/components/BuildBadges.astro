---
/**
 * BuildBadges — service-ribbon chips for the header.
 *
 * Each chip is a small rectangular bar: a woven, striped fabric panel on the
 * left (each ribbon gets its own stripe palette) and a dark enamel plate on
 * the right carrying a label row and an embossed value row, all inside a
 * metallic gold bezel. Data comes from src/data/build-stats.ts.
 */
import { buildStats } from '../data/build-stats';

const elapsed = `DAY ${String(buildStats.day).padStart(2, '0')} · HR ${String(buildStats.hour).padStart(2, '0')}`;
---

<div class="wd-build-badges" role="note" aria-label="Build provenance">
  <span class="wd-ribbon wd-ribbon--tool" title={`Built with ${buildStats.tool}`}>
    <span class="wd-ribbon__bar" aria-hidden="true"></span>
    <span class="wd-ribbon__text">
      <span class="wd-ribbon__label">Built with</span>
      <span class="wd-ribbon__value">{buildStats.tool}</span>
    </span>
  </span>
  <span class="wd-ribbon wd-ribbon--model" title={`Model: ${buildStats.model}`}>
    <span class="wd-ribbon__bar" aria-hidden="true"></span>
    <span class="wd-ribbon__text">
      <span class="wd-ribbon__label">Using</span>
      <span class="wd-ribbon__value">{buildStats.model}</span>
    </span>
  </span>
  <span class="wd-ribbon wd-ribbon--time" title="Development time elapsed">
    <span class="wd-ribbon__bar" aria-hidden="true"></span>
    <span class="wd-ribbon__text">
      <span class="wd-ribbon__label">Elapsed</span>
      <span class="wd-ribbon__value">{elapsed}</span>
    </span>
  </span>
</div>
