---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

interface DossierFrontmatter {
  /** Which package this page documents. Omit for general pages. */
  pkg?: "mod-types" | "utils";
  /** Stamp text, e.g. "Stable", "Draft". Omit to hide the stamp. */
  stamp?: string;
  /** Document version shown in the file header. */
  version?: string;
}

type Route = StarlightRouteData;
const route: Route = Astro.locals.starlightRoute;
const { entry } = route;

const fm = entry.data as Route["entry"]["data"] & DossierFrontmatter;

const isSplash = fm.template === "splash";

const pkgId: Record<NonNullable<DossierFrontmatter["pkg"]>, string> = {
  "mod-types": "PKG-01",
  utils: "PKG-02",
};

const docId = fm.pkg ? pkgId[fm.pkg] : "GEN-00";
const pkgName = fm.pkg === "mod-types" ? "mod (global)" : fm.pkg === "utils" ? "bf6-portal-utils" : "bf6-portal-sdk";
---

{!isSplash && (
<header class="dossier" data-pkg={fm.pkg}>
  <dl class="dossier__meta">
    <div><dt>File</dt><dd>{docId}</dd></div>
    <div><dt>Package</dt><dd>{pkgName}</dd></div>
    {fm.version && <div><dt>Rev</dt><dd>{fm.version}</dd></div>}
  </dl>
  <div class="dossier__body">
    <h1 id="_top" class="dossier__title">{fm.title}</h1>
  </div>
  {fm.stamp && <span class="dossier__stamp">{fm.stamp}</span>}
</header>
)}
