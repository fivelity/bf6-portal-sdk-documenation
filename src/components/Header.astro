---
/**
 * Header override.
 *
 * Wraps Starlight's default Header unmodified, and adds a badge strip
 * below the main nav row (see BuildBadges.astro / src/data/build-stats.ts)
 * that celebrates the AI-assisted build process. Styled in
 * src/styles/theme/chrome.css under "Build provenance badge strip".
 */
import Default from '@astrojs/starlight/components/Header.astro';
import BuildBadges from './BuildBadges.astro';
---

<div class="wd-header-wrap">
  <Default {...Astro.props}><slot /></Default>
  <div class="wd-header-badges-row">
    <BuildBadges />
  </div>
</div>
